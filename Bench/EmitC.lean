import CertiKOS

/-!
# Print the verified ClightL ASTs as C

A mechanical printer from `ClightL.Stmt` to C. This is the "trusted compiler"
route C1 from `SCOPING.md` §4.6: the printer is not verified, but it is a
direct, structural rendering of the AST, so what runs is the code we proved.
The primitives are printed as calls to `FAI_t`, `get_n`, `inc_n` and `hold`,
CertiKOS's names; `bench/ours_prims.h` implements them with atomics.
-/

open ClightL Ticket

def primName : Prim → String
  | .faiTicket => "FAI_t" | .getNow => "get_n" | .incNow => "inc_n" | .hold => "hold"

def binOpC : BinOp → String
  | .add => "+" | .sub => "-" | .eq => "==" | .ne => "!=" | .ltu => "<"

def exprC : Expr → String
  | .const v => s!"{v.toNat}u"
  | .var x => x
  | .bin op a b => s!"({exprC a} {binOpC op} {exprC b})"

def stmtC (ind : String) : Stmt Prim → String
  | .skip => ind ++ ";\n"
  | .assign x e => s!"{ind}{x} = {exprC e};\n"
  | .seq a b => stmtC ind a ++ stmtC ind b
  | .ite e a b =>
    s!"{ind}if ({exprC e}) " ++ "{\n" ++ stmtC (ind ++ "  ") a ++ ind ++ "} else {\n" ++
      stmtC (ind ++ "  ") b ++ ind ++ "}\n"
  | .while e b =>
    s!"{ind}while ({exprC e}) " ++ "{\n" ++ stmtC (ind ++ "  ") b ++ ind ++ "}\n"
  | .call x p args => s!"{ind}{x} = {primName p}({", ".intercalate (args.map exprC)});\n"

def exprVars : Expr → List String
  | .const _ => []
  | .var x => [x]
  | .bin _ a b => exprVars a ++ exprVars b

def stmtVars : Stmt Prim → List String
  | .skip => []
  | .assign x e => x :: exprVars e
  | .seq a b => stmtVars a ++ stmtVars b
  | .ite e a b => exprVars e ++ stmtVars a ++ stmtVars b
  | .while e b => exprVars e ++ stmtVars b
  | .call x _ args => x :: (args.map exprVars).flatten

def dedup : List String → List String
  | [] => []
  | x :: xs => if xs.contains x then dedup xs else x :: dedup xs

def funC (name : String) (s : Stmt Prim) : String :=
  let vs := dedup (stmtVars s)
  let decl := ", ".intercalate (vs.map (· ++ " = 0"))
  let unused := String.join (vs.map (fun v => s!"(void){v}; "))
  s!"static inline void {name}(void) " ++ "{\n" ++ s!"  uint32_t {decl};\n" ++ stmtC "  " s ++
    s!"  {unused}\n" ++ "}\n"

def main : IO Unit := do
  IO.println "/* Generated by Bench/EmitC.lean from the verified ClightL ASTs"
  IO.println "   Ticket.acquireCode and Ticket.releaseCode. Do not edit. */"
  IO.println "#include <stdint.h>"
  IO.println (funC "ours_acq" acquireCode)
  IO.println (funC "ours_rel" releaseCode)
