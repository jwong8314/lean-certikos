import CertiKOS

/-!
# Print the translated PyL ASTs as Python

A structural printer from `PyL.Cmd` to Python source, the Python counterpart of
`EmitC.lean`. What it prints is `ClightToPy.tr TicketPy.impl (clientCode N)`,
the translation proved equivalent to the C machine in `TicketPy.lean`. The
printer itself is not verified.

`with L:` is a single `threading.Lock`. Objects live in a table `OBJ`; object
`0` is the lock record `lk` with attributes `ticket` and `now`. The reserved
PyL variable `$r` is printed as `_r`.

Usage: `emitpy N` prints a script; `python3 script.py T` runs T threads of the
client and checks that `lk.ticket == lk.now == T*N mod 2**32`.
-/

open PyL

def pyName (x : Var) : String := if x = "$r" then "_r" else x

def exprPy : PyL.Expr → String
  | .const v => toString v
  | .var x => pyName x
  | .bin op a b =>
    let a := exprPy a; let b := exprPy b
    match op with
    | .add => s!"({a} + {b})" | .sub => s!"({a} - {b})" | .mul => s!"({a} * {b})"
    | .fdiv => s!"({a} // {b})" | .fmod => s!"({a} % {b})"
    | .eq => s!"int({a} == {b})" | .ne => s!"int({a} != {b})"
    | .lt => s!"int({a} < {b})" | .le => s!"int({a} <= {b})"
  | .not a => s!"int(not {exprPy a})"

def cmdPy (ind : String) : Cmd → String
  | .skip => ind ++ "pass\n"
  | .assign x e => s!"{ind}{pyName x} = {exprPy e}\n"
  | .load x o f => s!"{ind}{pyName x} = OBJ[{exprPy o}].{f}\n"
  | .store o f e => s!"{ind}OBJ[{exprPy o}].{f} = {exprPy e}\n"
  | .seq a b => cmdPy ind a ++ cmdPy ind b
  | .ite e a b =>
    s!"{ind}if {exprPy e}:\n" ++ cmdPy (ind ++ "    ") a ++ s!"{ind}else:\n" ++ cmdPy (ind ++ "    ") b
  | .while e b => s!"{ind}while {exprPy e}:\n" ++ cmdPy (ind ++ "    ") b
  | .atomic c => s!"{ind}with L:\n" ++ cmdPy (ind ++ "    ") c
  | .inAtomic c => cmdPy ind c

def cmdVars : Cmd → List String
  | .assign x _ | .load x _ _ => [pyName x]
  | .seq a b | .ite _ a b => cmdVars a ++ cmdVars b
  | .while _ c | .atomic c | .inAtomic c => cmdVars c
  | _ => []

def script (N : Nat) : String :=
  let body := ClightToPy.tr TicketPy.impl (TicketPy.clientCode N)
  let vars := (cmdVars body).eraseDups
  "# Generated by Bench/EmitPy.lean: ClightToPy.tr TicketPy.impl (clientCode " ++ toString N ++ ").\n" ++
  "# Proved equivalent to the C machine in CertiKOS/TicketPy.lean. Do not edit.\n" ++
  "import sys, threading, time\n\n" ++
  "class Obj:\n    pass\n\n" ++
  "lk = Obj()\nlk.ticket = 0\nlk.now = 0\nOBJ = {0: lk}\nL = threading.Lock()\n\n" ++
  "def client():\n" ++
  "    " ++ " = ".intercalate vars ++ " = 0\n" ++
  cmdPy "    " body ++ "\n" ++
  "if __name__ == \"__main__\":\n" ++
  "    T = int(sys.argv[1]) if len(sys.argv) > 1 else 4\n" ++
  "    ts = [threading.Thread(target=client) for _ in range(T)]\n" ++
  "    t0 = time.perf_counter()\n" ++
  "    for t in ts: t.start()\n" ++
  "    for t in ts: t.join()\n" ++
  "    dt = time.perf_counter() - t0\n" ++
  "    want = (T * " ++ toString N ++ ") % 2**32\n" ++
  "    ok = lk.ticket == want and lk.now == want\n" ++
  "    print(f\"tr-python T={T} N=" ++ toString N ++
    " ticket={lk.ticket} now={lk.now} want={want} ok={ok} secs={dt:.3f}\")\n" ++
  "    sys.exit(0 if ok else 1)\n"

def main (args : List String) : IO Unit :=
  IO.print (script (args.getD 0 "1000").toNat!)
